# ============================================================================
# Docker Compose Configuration
# Copy to .env in project root:  cp docker/.env.example .env
#
# Supabase is NOT bundled here - it runs as a separately-managed instance
# (its own docker stack, e.g. from https://github.com/supabase/supabase's
# docker/ directory) that this app and any other services simply point at.
# ============================================================================

# --- App ---
APP_PORT=80
NG_APP_TENANT=the-eighth

# --- Supabase (external instance) ---
# Public URL of the Supabase API gateway. Reached directly by the browser,
# so it must be an address the browser can resolve (not a docker service name).
SUPABASE_URL=http://localhost:8000

# ANON_KEY is public - it is baked into the browser bundle by design.
# Copy it from the Supabase instance's own .env.
ANON_KEY=<copy from the Supabase instance's .env>

# SERVICE_ROLE_KEY bypasses all RLS. Only needed for the on-demand
# `docker compose run --rm migrate*` services, never baked into the app image.
# Copy it from the Supabase instance's own .env.
SERVICE_ROLE_KEY=<copy from the Supabase instance's .env>

# Direct Postgres connection string, only needed to bootstrap a brand-new
# Supabase instance's schema via `scripts/run-migrations.sh --schema` or
# `scripts/deploy.sh --fresh`. Not used by the app itself.
# SUPABASE_DB_URL=postgres://postgres:PASSWORD@supabase-host:5432/postgres
