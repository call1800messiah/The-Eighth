# ============================================================================
# Docker Compose Configuration
# Copy to .env in project root:  cp docker/.env.example .env
#
# EVERY value below marked <generate> must be replaced before the stack will
# start. There are deliberately no working defaults: the previous version of
# this file shipped Supabase's public demo keys, which would have left the
# service_role key (full database access, RLS bypass) known to anyone.
# ============================================================================

# --- App ---
APP_PORT=80
NG_APP_TENANT=the-eighth

# --- Studio ---
# Studio has no login of its own, so compose binds it to 127.0.0.1 only.
# Reach it with:  ssh -L 3001:127.0.0.1:3001 user@server
STUDIO_PORT=3001

# --- Database ---
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=<generate>

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=<generate>

# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with the JWT_SECRET above.
# Generate both here (paste your JWT_SECRET into the form):
#   https://supabase.com/docs/guides/self-hosting/docker#api-keys
#
# Or locally, without sending the secret anywhere:
#   npx --yes jsonwebtoken-cli sign '{"iss":"supabase","role":"anon","exp":<unix-ts>}' "$JWT_SECRET"
#   npx --yes jsonwebtoken-cli sign '{"iss":"supabase","role":"service_role","exp":<unix-ts>}' "$JWT_SECRET"
#
# ANON_KEY is public - it is baked into the browser bundle by design.
# SERVICE_ROLE_KEY bypasses all RLS. Never expose it to the client.
ANON_KEY=<generate>
SERVICE_ROLE_KEY=<generate>

# --- Realtime ---
# Generate with: openssl rand -base64 48
SECRET_KEY_BASE=<generate>
# Generate with: openssl rand -hex 16
DB_ENC_KEY=<generate>

# --- Deployment ---
# SITE_URL: The external URL where the app is accessible.
# Used by GoTrue for auth redirects and by Studio for the public URL.
#
# Session JWTs travel in the Authorization header and are stored in
# localStorage. Over plain http:// they are readable by anyone on the path,
# so use https:// for anything beyond a trusted local network.
#   Local development: http://localhost
#   Production:        https://your-domain.com
SITE_URL=http://localhost
