{
  "name": "the-eighth",
  "version": "0.25.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "migrate:validate": "npx tsx scripts/validate-firebase-data.ts",
    "migrate:export": "npx tsx scripts/firebase-export.ts",
    "migrate:transform": "npx tsx scripts/transform-and-migrate.ts",
    "migrate:storage": "npx tsx scripts/migrate-storage.ts",
    "migrate:verify": "npx tsx scripts/validate-migration.ts",
    "db:reset": "npx supabase db reset && npm run migrate:transform && npm run migrate:storage",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:save": "docker save the-eighth-app | gzip > the-eighth-app.tar.gz",
    "deploy:package": "bash scripts/package-for-deploy.sh",
    "deploy:run": "bash scripts/deploy.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/platform-browser-dynamic": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@supabase/supabase-js": "^2.117.1",
    "g-sheets-api": "^2.2.0",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.16",
    "ngx-img-cropper": "^14.0.1",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.24",
    "@angular-devkit/build-angular": "^21.2.24",
    "@angular-devkit/schematics-cli": "^21.2.24",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@ngx-env/builder": "^21.0.1",
    "@types/jasmine": "~3.6.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20.19.43",
    "firebase-admin": "^13.10.0",
    "fuzzy": "^0.1.3",
    "inquirer": "^8.2.7",
    "inquirer-autocomplete-prompt": "^1.4.0",
    "jasmine-core": "5.4.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "supabase": "^2.117.0",
    "ts-node": "~10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
